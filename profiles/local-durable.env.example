# Single-node durable deployment profile. Copy to a private .env before use.
RAG_PERSIST_DATA=true
RAG_STORAGE_ROOT=/data
RAG_BIND_ADDRESS=127.0.0.1
RAG_PUBLISHED_PORT=8000
RAG_JOB_WORKERS=2
RAG_MAX_JOBS=32
RAG_MAX_JOBS_PER_TENANT=8
RAG_MAX_TENANT_STORAGE_BYTES=2147483648
RAG_API_KEYS_JSON={"replace-with-a-16-character-minimum-key":{"subject":"admin","tenant_id":"local","roles":["reader","writer","operator"]}}
