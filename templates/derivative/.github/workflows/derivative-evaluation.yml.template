name: derivative-evaluation

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  governed-evaluation-metadata:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-python@v6
        with:
          python-version: "3.11"
          cache: pip
      - name: Install base validation dependencies
        run: python -m pip install -r requirements.txt -r requirements-dev.txt
      - name: Require release-ready domain evaluation governance
        run: >-
          python scripts/validate_derivative_evaluation.py
          {{PACKAGE_NAME}}/evals/governance.json
          --require-ready
